{
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/.server/**/*.ts",
    "**/.server/**/*.tsx",
    "**/.client/**/*.ts",
    "**/.client/**/*.tsx",
    ".react-router/types/**/*"
  ],
  // Machine-local build output: `resources/` holds the packaged SDK copies
  // (gitignored) and `dist-electron/` the installer. Both contain thousands of
  // files tsc cannot check, which made `typecheck:staged` fail on any
  // checkout that has been packaged. Listing `exclude` replaces the default,
  // so node_modules is repeated.
  "exclude": ["node_modules", "dist-electron", "resources"],
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "es2022"],
    "target": "es2022",
    "types": ["@react-router/node", "vite/client"],
    "rootDirs": [".", "./.react-router/types"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "ignoreDeprecations": "6.0",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "#/*": ["./src/*"]
    },
    // Vite takes care of building everything, not tsc.
    "noEmit": true
  }
}
